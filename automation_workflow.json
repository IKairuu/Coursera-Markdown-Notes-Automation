    {
      "parameters": {
        "jsCode": "var trans = []\nfor (const item of $input.all()) {\n  for (const [title, lines] of Object.entries(item.json)) {\n    trans.push({\n      json: {\n        transcriptions: \n        {title,\n        text: lines.map(x => x.trim()).join(\" \")}\n      }\n    })\n  }\n}\n\n\nreturn trans;"
      },
