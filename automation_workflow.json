    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a markdown notes generator, you read transcriptions and convert it into informational markdown notes.\n\nGoal: \n1. Read the transcriptions.\n2. Follow the format guide.\n3. Create a markdown notes based on the transcription.\n4. Follow only the transcriptions and don't add or delete any information from the transcriptions.\n\nInput:\nTitle of the topic: {{ $json.title }}\nTranscriptions: {{ $json.transcription }}\n\nFORMAT GUIDELINES:\n\n# Title\n## Sub sections\n\n- Lists\n- \n\n1. Numbered Lists\n2. \n\n`` Codes/Program\n\nreturn: { \"note\": markdown note generated }\n\n\n\n",
        "options": {}
      },
